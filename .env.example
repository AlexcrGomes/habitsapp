# Copie para .env e troque a senha. O arquivo .env não vai para o git.
POSTGRES_DB=habits
POSTGRES_USER=habits
POSTGRES_PASSWORD=troque-esta-senha

# true quando a aplicação estiver atrás de HTTPS (produção)
HABITS_COOKIE_SECURE=false

# Notificações (spec 011): gere UMA vez com scripts/gerar-vapid.sh e cole aqui. Vazias, as
# notificações aparecem como indisponíveis. Nunca troque as de produção (os aparelhos perdem a inscrição).
HABITS_VAPID_PUBLIC_KEY=
HABITS_VAPID_PRIVATE_KEY=
# Contato do responsável, exigido pelos serviços de push (ex.: mailto:voce@exemplo.com)
HABITS_VAPID_SUBJECT=

# Só em produção: endereço do Habits no servidor compartilhado, ex.: habits.alexapps.duckdns.org
HABITS_DOMAIN=
